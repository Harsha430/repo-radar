# ─────────────────────────────────────────────
# RepoRadar — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# GitHub Personal Access Token
# IMPORTANT: Must be named GH_PAT (not GITHUB_TOKEN) to avoid conflict with
# the GitHub Actions built-in GITHUB_TOKEN which has limited scope.
# Create at: github.com/settings/tokens → Fine-grained → read-only public repos
GH_PAT=ghp_your_token_here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "anthropic" (Claude) or "groq" (Llama via Groq)
# You only need the API key for the provider you choose.
LLM_PROVIDER=anthropic

# Anthropic (Claude) API Key — used when LLM_PROVIDER=anthropic
# Get at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Groq API Key — used when LLM_PROVIDER=groq (free tier available, very fast)
# Get at: console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_key_here

# Reddit API Credentials
# Create a "script" app at: reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Supabase Project Credentials
# Found at: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Twilio WhatsApp Credentials
# Found at: twilio.com/console
# IMPORTANT: First send "join <word>" from your WhatsApp to the sandbox number
TWILIO_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+919876543210
